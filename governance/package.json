{
  "name": "@federation-platform/governance",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "compose": "tsx src/compose.ts",
    "check:composition": "tsx src/compose.ts --check",
    "check:node-rules": "tsx src/cli/node-rules.ts",
    "check:operations": "tsx src/cli/operations.ts",
    "check:breaking": "tsx src/cli/breaking.ts",
    "check:policy": "tsx src/cli/policy.ts",
    "check:decisions": "tsx src/cli/decisions.ts",
    "check:all": "tsx src/cli/all.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm check:all"
  },
  "dependencies": {
    "@theguild/federation-composition": "^0.27.0",
    "graphql": "^16"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
